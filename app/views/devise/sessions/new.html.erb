<%= form_with model: resource, scope: resource_name, url: session_path(resource_name) do |form| %>
  <div class="form-inputs">
    <h2>Log in</h2>
    <%= form.field :email, as: :email_field, autofocus: true, autocomplete: "email" %>
    <%= form.field :password, as: :password_field, autocomplete: "current-password" %>
    <% if devise_mapping.rememberable? %>
      <div class="form-check mb-3">
        <%= form.check_box :remember_me, class: "form-check-input" %>
        <%= form.label :remember_me, class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= form.submit "Log in", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
