<%= form_with model: resource, scope: resource_name, url: registration_path(resource_name) do |form| %>
  <div class="form-inputs">
    <h2>Sign up for free</h2>
    <%= form.error_summary %>
    <%= form.field :first_name, required: true, autofocus: true, autocomplete: "given-name" %>
    <%= form.field :last_name, required: true, autocomplete: "family-name" %>
    <%= form.field :email, as: :email_field, required: true, autocomplete: "email" %>
    <%= form.field :password, as: :password_field, required: true, autocomplete: "new-password",
          hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length) %>
    <%= form.field :password_confirmation, as: :password_field, required: true, autocomplete: "new-password" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Sign up!", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
