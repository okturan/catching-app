<%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), method: :put do |form| %>
  <div class="form-inputs">
    <h2>Edit <%= resource_name.to_s.humanize %></h2>
    <%= form.error_summary %>
    <%= form.field :first_name, required: true, autofocus: true, autocomplete: "given-name" %>
    <%= form.field :last_name, required: true, autocomplete: "family-name" %>
    <%= form.field :email, as: :email_field, required: true, autocomplete: "email" %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p>Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
    <% end %>

    <%= form.field :password, as: :password_field, optional: true, autocomplete: "new-password",
          hint: "leave it blank if you don't want to change it" %>
    <%= form.field :password_confirmation, as: :password_field, optional: true, autocomplete: "new-password" %>
    <%= form.field :current_password, as: :password_field, required: true, autocomplete: "current-password",
          hint: "we need your current password to confirm your changes" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Update", class: "btn btn-primary" %>
  </div>
<% end %>

<p>Unhappy? <%= link_to "Cancel my account", registration_path(resource_name), data: { turbo_confirm: "Are you sure?", turbo_method: :delete } %></p>

<%= link_to "Back", dashboard_path, class: "back-link" %>
