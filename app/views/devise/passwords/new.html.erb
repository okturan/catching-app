<h2>Forgot your password?</h2>

<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :post do |form| %>
  <div class="form-inputs">
    <%= form.error_summary %>
    <%= form.field :email, as: :email_field, required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Send me reset password instructions", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
