<h2>Change your password</h2>

<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put do |form| %>
  <%= form.hidden_field :reset_password_token %>

  <div class="form-inputs">
    <%= form.error_summary %>
    <%= form.field :password, as: :password_field, label: "New password", required: true, autofocus: true, autocomplete: "new-password",
          hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length) %>
    <%= form.field :password_confirmation, as: :password_field, label: "Confirm your new password", required: true, autocomplete: "new-password" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Change my password", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
