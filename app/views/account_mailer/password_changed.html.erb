<% content_for :preheader, "The password of your Catching App account was just changed." %>
<%= email_heading "Your password was changed" %>
<%= email_paragraph "The password of the Catching App account for #{@user.email} was changed on #{Time.current.utc.to_fs(:date_time)} (UTC). Every other browser was signed out." %>
<%= email_paragraph "If that was you, there's nothing to do." %>
<%= email_paragraph "If it wasn't, choose a new password now:" %>
<%= email_button "Reset my password", new_password_url, fallback: false %>
