<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= message.subject %></title>
  </head>
  <body style="margin: 0; padding: 0; background: #f2efe9; -webkit-text-size-adjust: 100%;">
    <% if content_for?(:preheader) %>
      <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: #f2efe9;"><%= yield :preheader %></div>
    <% end %>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f2efe9" style="background: #f2efe9;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 560px;">
            <tr>
              <td style="padding: 0 4px 16px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 19px; font-weight: 800; letter-spacing: -0.02em; color: #141414;">
                Catching.app
                <div style="width: 40px; height: 4px; margin-top: 8px; background: #ffc65a; line-height: 4px; font-size: 4px;">&nbsp;</div>
              </td>
            </tr>
            <tr>
              <td bgcolor="#ffffff" style="background: #ffffff; border: 1px solid #e2ddd3; border-radius: 6px; padding: 32px 28px 16px;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding: 18px 4px 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #6b6762;">
                <% if content_for?(:footer) %><%= yield :footer %><br><% end %>
                Catching App finds a time that works for everyone, in each friend's own zone.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
