<% content_for :preheader, "Choose a new password for your Catching App account." %>
<%= email_heading "Reset your password" %>
<%= email_paragraph "Someone asked to reset the password of the Catching App account for #{@user.email}." %>
<%= email_button "Choose a new password", edit_password_url(@user.password_reset_token) %>
<%= email_note "The link works for an hour." %>
<%= email_note "If that wasn't you, ignore this email: your password stays as it is." %>
