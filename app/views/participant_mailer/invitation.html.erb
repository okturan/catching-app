<p>Invitation from <%= mail_safe(@organizer.name) %> (<%= @organizer.email %>)</p>
<p><strong><%= mail_safe(@event.name) %></strong></p>
<% if @offer %><p><%= @offer %></p><% end %>
<p>Paint the times that work for you:</p>
