<% content_for :preheader, @reason_line %>
<%= email_paragraph @reason_line %>
<% if @renamed %><%= email_paragraph "The event is now called #{mail_safe(@renamed.last)} (was #{mail_safe(@renamed.first)})" %><% end %>
<%= email_facts("Where:" => @place, "How long:" => @duration) %>
<% if @plan.any? %>
  <%= email_paragraph "Plan:" %>
  <%= email_list @plan %>
<% end %>
<% if @situation %><%= email_times @situation %><% end %>
<% if @link %>
  <%= email_paragraph "Open your link to see the event as it stands now:" %>
  <%= email_button "Open the event", @link %>
<% else %>
  <%= email_paragraph "Open the link from your invitation to see the event as it stands now." %>
<% end %>
<%= email_note "To stop hearing about this event, open your link and choose Leave this event." %>
