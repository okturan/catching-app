<% content_for :preheader, "Your reply to #{mail_safe(@event.name)} is saved." %>
<%= email_heading "Reply saved" %>
<%= email_paragraph do %>Your reply to <strong><%= mail_safe(@event.name) %></strong> is saved.<% end %>
<% if @declined %>
  <%= email_paragraph "You said none of the offered times work for you." %>
<% else %>
  <%= email_paragraph "Your available times (#{@recipient_ranges[:zone]}):" %>
  <%= email_times(*@recipient_ranges[:days].map { |day, ranges| "#{day}: #{ranges.join(", ")}" }) %>
  <% if @recipient_ranges[:more].positive? %><%= email_note "and #{@recipient_ranges[:more]} more days." %><% end %>
  <% if @event_ranges[:zone] != @recipient_ranges[:zone] %>
    <%= email_note "In the event's zone (#{@event_ranges[:zone]}):" %>
    <%= email_times(*@event_ranges[:days].map { |day, ranges| "#{day}: #{ranges.join(", ")}" }) %>
  <% end %>
<% end %>
<%= email_note "To change your reply, use the link from your invitation. You will hear from us when the time is set, and if the organizer changes the plan." %>
