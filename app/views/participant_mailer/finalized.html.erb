<% content_for :preheader, "#{mail_safe(@event.name)}: #{@recipient_window}" %>
<%= email_paragraph do %><strong><%= mail_safe(@event.name) %></strong> is set.<% end %>
<%= email_times @recipient_window, (@recipient_window != @event_window ? "In the event's zone: #{@event_window}" : nil) %>
<%= email_facts("Where:" => @place, "How long:" => @duration) %>
<% if @plan.any? %>
  <%= email_paragraph "Plan:" %>
  <%= email_list @plan %>
<% end %>
<%= email_paragraph "Add it to your calendar, with a reminder:" %>
<%= email_button "Add to calendar", @calendar_url, fallback: false %>
<% if @link %>
  <%= email_paragraph "Open your link for the details:" %>
  <%= email_button "Open the event", @link %>
<% else %>
  <%= email_paragraph "Open your organizer link for the details." %>
<% end %>
<%= email_note "You will hear from us again only if the organizer changes the plan, reopens the time or cancels." %>
<% if @link %><%= email_note "To stop hearing about this event, open your link and choose Leave this event." %><% end %>
