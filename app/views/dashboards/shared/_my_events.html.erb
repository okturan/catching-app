<% [ [ "Organizing", @organizing ], [ "Invited", @invited ] ].each do |heading, participations| %>
  <section aria-labelledby="<%= heading.parameterize %>-heading">
    <h2 class="section-title" id="<%= heading.parameterize %>-heading"><%= heading %> <span class="plate"><%= participations.size %></span></h2>

    <% if participations.empty? %>
      <div class="empty">
        <% if heading == "Organizing" %>
          <span>Nothing planned yet.</span>
          <%= link_to "Plan a meeting", new_event_path, class: "plate plate-button-sm" %>
        <% else %>
          <span>No invitations yet. Guest links you open while signed in show up here.</span>
        <% end %>
      </div>
    <% else %>
      <div class="event-list">
        <% participations.each do |participation| %>
          <% event = participation.event %>
          <%= link_to my_participation_path(participation), class: "event-face" do %>
            <h3><%= event.name %></h3>
            <span class="event-face-time">
              <% if event.cancelled? %>
                <span class="body-font">cancelled</span>
              <% elsif event.status? %>
                <%= event.start_time.utc.strftime("%a %-d %b, %H:%M") %> UTC
              <% else %>
                <span class="body-font">pending</span>
              <% end %>
            </span>
            <p><%= event.description %></p>
            <span class="event-face-state">
              <% if event.cancelled? %>cancelled ·<% end %>
              <% if participation.organizer? %>
                <%= pluralize(event.guests.active.count, "guest") %>
              <% else %>
                by <%= event.organizer&.display_name(viewer_role: :guest) %> ·
                <% if participation.declined_at.present? %>
                  you said none of these times work
                <% elsif participation.responded_at.present? %>
                  you replied
                <% else %>
                  waiting for your reply
                <% end %>
              <% end %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
