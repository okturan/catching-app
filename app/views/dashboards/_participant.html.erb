<% event = participant.event %>
<%= link_to participant_path(participant), class: "event-face" do %>
  <h3><%= event.name %></h3>
  <span class="event-face-time">
    <% if event.cancelled? %>
      <span class="body-font">cancelled</span>
    <% elsif event.finalized? %>
      <%= zoned_time(event.start_time, event.time_zone, format: :date_time) %>
    <% else %>
      <span class="body-font">pending</span>
    <% end %>
  </span>
  <% if event.description.present? %><p><%= event.description %></p><% end %>
  <span class="event-face-state">
    <% if event.cancelled? %>cancelled ·<% end %>
    <% if participant.organizer? %>
      <%= pluralize(guest_counts[event.id].to_i, "guest") %>
    <% else %>
      by <%= event.organizer.display_name %> ·
      <% if participant.declined_at? %>
        you said none of these times work
      <% elsif participant.responded_at? %>
        you replied
      <% else %>
        waiting for your reply
      <% end %>
    <% end %>
  </span>
<% end %>
