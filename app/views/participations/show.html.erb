<% content_for :head do %>
  <meta name="robots" content="noindex">
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<% content_for :canonical_url, root_url %>
<% content_for :meta_title, "#{@event.name} · Catching App" %>

<input id="received-time-slots" type="hidden" value="<%= @offered_slots.to_json %>">
<input id="my-time-slots" type="hidden" value="<%= @my_slots.to_json %>">
<input id="availability-counts" type="hidden" value="<%= @availability_counts.to_json %>">
<input id="consensus-time-slots" type="hidden" value="<%= @consensus_slots.to_json %>">
<% if @event.finalized? %>
  <input id="final-window" type="hidden" value="<%= [@event.start_time.iso8601, @event.end_time.iso8601].to_json %>">
<% end %>

<div class="event-show-grid">
  <div class="event-show-card">
    <%= render "participations/show/display", event: @event, participant: @participant %>

    <div class="event-panel">
      <%= render "participations/show/event", event: @event, participant: @participant, plan: @plan %>
      <%= render "participations/show/people", event: @event, participant: @participant, guests: @guests, counts: @counts %>
      <%= render "participations/show/actions", event: @event, participant: @participant, untold_changes: @untold_changes %>
    </div>

    <% if @revealed_url %>
      <div class="alert alert-warning position-static mt-3" role="status">
        Link for <%= @revealed_guest.email %> (shown once): <code><%= @revealed_url %></code>
      </div>
    <% end %>

    <% if @participant.guest? %>
      <%= render "participations/show/answer", event: @event, participant: @participant %>
    <% elsif @event.open? %>
      <%= form_with url: scoped_path(:finalization), method: :post, id: "finalize-form" do %>
        <input id="final-time-slot-array" name="time_slots[time_slot_array]" type="hidden" value="">
      <% end %>
    <% end %>

    <% if token_request? && !@participant.claimed? && !@participant.left? %>
      <p class="mt-3"><%= link_to "Keep this event in your account", scoped_path(:claim), class: "btn btn-link" %></p>
    <% end %>

    <% if @participant.organizer? %>
      <%= render "participations/show/guests", event: @event, organizer: @participant, guests: @guests,
            deliveries: @deliveries, counts: @counts, slot_counts: @slot_counts %>
      <%= render "participations/show/ends", event: @event unless @event.cancelled? %>
    <% end %>
  </div>

  <%= render "participations/show/grid", event: @event, participant: @participant, role: @role, counts: @counts,
        revision_notice: @revision_notice, every_offer_past: @every_offer_past %>
</div>
