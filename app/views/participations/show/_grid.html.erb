<div class="time-grid-panel time-grid-show-wrapper">
  <div class="time-grid-scroll">
    <table id="time-grid-show" class="time-grid" role="grid" aria-label="Availability"
      data-role="<%= role %>"
      data-slot-minutes="<%= event.slot_minutes %>"
      data-event-time-zone="<%= event.time_zone %>"
      data-not-before="<%= TimeSlot::PAST_GRACE.ago.utc.iso8601 %>"
      <%= "data-finalized" if event.finalized? %>
      <%= "data-cancelled" if event.cancelled? %>
      <% if event.duration_minutes %>data-duration-minutes="<%= event.duration_minutes %>"<% end %>></table>
  </div>
  <div class="grid-action-bar">
    <%# When nothing offered is still in the future, "save again" would be a lie. %>
    <% case (every_offer_past ? nil : revision_notice) %>
    <% when :stale %>
      <p class="grid-notice" role="status">The organizer changed the offered times on
        <%= zoned_time(event.offer_revised_at, event.time_zone, format: :date_time) %>:
        <%= event.offer_revision_added %> added, <%= event.offer_revision_removed %> removed. Check your picks and save again.</p>
    <% when :voided %>
      <p class="grid-notice" role="status">None of the times you picked are offered any more. Pick again.</p>
    <% when :declined_added %>
      <p class="grid-notice" role="status">You said none of these worked. New times were added.</p>
    <% when :reopened %>
      <p class="grid-notice" role="status">The set time was withdrawn on
        <%= zoned_time(event.reopened_at, event.time_zone, format: :date_time) %>. Check your picks and save.</p>
    <% end %>
    <% organizing = participant.organizer? && event.open? %>
    <% if organizing && !every_offer_past && (counts[:stale] + counts[:voided]).positive? %>
      <p class="grid-notice" role="status"><%= pluralize(counts[:stale] + counts[:voided], "guest has", plural: "guests have") %> not answered the current times</p>
    <% end %>
    <% guest_dead_end = participant.guest? && event.open? && every_offer_past %>
    <span id="selection-summary" aria-live="polite"><%= guest_dead_end ? "All the offered times have passed." : "No times selected" %></span>
    <fieldset id="paint-mode" class="paint-mode" role="radiogroup" aria-label="Touch mode">
      <label><input type="radio" name="paint-mode" value="scroll" checked><span>Scroll</span></label>
      <label><input type="radio" name="paint-mode" value="paint"><span>Paint</span></label>
    </fieldset>
    <% if participant.guest? && event.open? %>
      <button type="submit" form="availability-form" class="btn-meeting px-5"<%= " hidden" if guest_dead_end %>>Save</button>
    <% elsif organizing && every_offer_past %>
      <span class="grid-every-past">
        <span>Every offered time has passed.</span>
        <%= link_to "Change the times", scoped_path(:offer, edit: true), class: "plate-button-sm" %>
      </span>
    <% elsif organizing && counts[:replied].positive? %>
      <button type="submit" form="finalize-form" class="btn-meeting px-5">Set in stone</button>
    <% elsif organizing && counts[:voided].positive? %>
      <span class="text-muted">No one has answered the current times yet.</span>
    <% elsif organizing %>
      <span class="text-muted">No replies yet. Invitations sent to <%= pluralize(counts[:invited], "person", plural: "people") %>.</span>
    <% end %>
  </div>
</div>
