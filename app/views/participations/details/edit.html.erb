<% content_for :head do %>
  <meta name="robots" content="noindex">
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<% content_for :canonical_url, root_url %>
<% content_for :meta_title, "Edit details · #{@event.name} · Catching App" %>

<div class="container py-5" id="event-details">
  <h1>Edit details</h1>
  <div class="form-inputs details-face">
    <p class="details-facts"><%= @event.slot_minutes %>-minute slots · <%= @event.time_zone %></p>
    <% if @event.status? %>
      <p class="details-facts">Set in stone:
        <%= zoned_time(@event.start_time, @event.time_zone, format: "%a %-d %b %Y %H:%M") %> to
        <%= zoned_time(@event.end_time, @event.time_zone) %></p>
    <% end %>

    <%= form_with model: @event, url: scoped_path(:details), method: :patch, id: "details-form" do |form| %>
      <% if @event.errors[:base].any? %>
        <div class="alert alert-danger position-static" role="alert"><%= @event.errors[:base].to_sentence %></div>
      <% end %>

      <div class="mb-3">
        <%= form.label :name, "Name", class: "form-label" %>
        <%= form.text_field :name, class: class_names("form-control", "is-invalid" => @event.errors[:name].any?), maxlength: 120, required: true %>
        <% if @event.errors[:name].any? %><div class="invalid-feedback d-block"><%= @event.errors[:name].to_sentence %></div><% end %>
      </div>
      <div class="mb-3">
        <%= form.label :description, "Description", class: "form-label" %>
        <%= form.text_area :description, class: class_names("form-control", "is-invalid" => @event.errors[:description].any?), rows: 4, maxlength: 2000, required: true %>
        <% if @event.errors[:description].any? %><div class="invalid-feedback d-block"><%= @event.errors[:description].to_sentence %></div><% end %>
      </div>
      <div class="mb-3">
        <%= form.label :place, "Place", class: "form-label" %>
        <%= form.text_field :place, class: class_names("form-control", "is-invalid" => @event.errors[:place].any?), maxlength: 200, placeholder: "Ege's place, Kadıköy — or 'Zoom'" %>
        <% if @event.errors[:place].any? %><div class="invalid-feedback d-block"><%= @event.errors[:place].to_sentence %></div><% end %>
      </div>
      <div class="mb-3">
        <%= form.label :place_url, "Link", class: "form-label" %>
        <%= form.url_field :place_url, class: class_names("form-control", "is-invalid" => @event.errors[:place_url].any?), maxlength: 2000, placeholder: "Link to join or a map link" %>
        <% if @event.errors[:place_url].any? %><div class="invalid-feedback d-block"><%= @event.errors[:place_url].to_sentence %></div><% end %>
      </div>
      <div class="mb-4">
        <%= form.label :duration_minutes, "Planned length", class: "form-label" %>
        <%= form.select :duration_minutes, duration_select_options(@event.slot_minutes, @event.duration_minutes),
          { include_blank: "Not set" }, class: class_names("form-select", "is-invalid" => @event.errors[:duration_minutes].any?) %>
        <% if @event.errors[:duration_minutes].any? %><div class="invalid-feedback d-block"><%= @event.errors[:duration_minutes].to_sentence %></div><% end %>
      </div>

      <%= form.submit "Save details", class: "btn btn-primary" %>
    <% end %>

    <section class="plan-editor" aria-labelledby="plan-heading">
      <h2 id="plan-heading">The plan</h2>
      <% timeline = @event.plan_timeline %>
      <% if @event.status? && @event.plan_minutes > @event.window_minutes %>
        <p class="plan-note">The plan runs <%= duration_label(@event.plan_minutes) %>; the set time is <%= duration_label(@event.window_minutes) %>.</p>
      <% end %>
      <% if timeline.empty? %>
        <p class="plan-empty">Nothing planned yet. Guests read the plan on their card, in order.</p>
      <% else %>
        <ol class="plan-items">
          <% timeline.each_with_index do |(activity, start), index| %>
            <li class="plan-item" id="plan-item-<%= activity.id %>">
              <div class="plan-item-head">
                <span><%= index + 1 %>. <%= plan_item_label(activity) %></span>
                <% if start %><%= zoned_time(start, @event.time_zone) %><% end %>
              </div>
              <%= form_with model: activity, url: scoped_path(:activity, activity), method: :patch, namespace: "plan_#{activity.id}",
                class: "plan-item-form", html: { aria: { label: "Edit #{activity.name}" } } do |form| %>
                <div class="plan-field-name">
                  <%= form.label :name, "Name", class: "visually-hidden" %>
                  <%= form.text_field :name, class: "form-control form-control-sm", maxlength: 80, required: true %>
                </div>
                <div>
                  <%= form.label :duration, "Length", class: "visually-hidden" %>
                  <%= form.select :duration, plan_duration_options(activity.duration), { include_blank: "No length" }, class: "form-select form-select-sm" %>
                </div>
                <div>
                  <%= form.label :description, "Description", class: "visually-hidden" %>
                  <%= form.text_field :description, class: "form-control form-control-sm", maxlength: 500, placeholder: "One line, optional" %>
                </div>
                <%= form.submit "Save", class: "btn btn-outline-primary btn-sm", aria: { label: "Save #{activity.name}" } %>
              <% end %>
              <div class="plan-controls">
                <%= button_to "Up", scoped_path(:activity_move, activity), method: :post, params: { move: { position: index - 1 } },
                  class: "btn btn-outline-secondary btn-sm", aria: { label: "Move #{activity.name} up" } %>
                <%= button_to "Down", scoped_path(:activity_move, activity), method: :post, params: { move: { position: index + 1 } },
                  class: "btn btn-outline-secondary btn-sm", aria: { label: "Move #{activity.name} down" } %>
                <%= button_to "Remove", scoped_path(:activity, activity), method: :delete, class: "btn btn-outline-danger btn-sm",
                  aria: { label: "Remove #{activity.name}" }, form: { data: { turbo_confirm: "Remove #{activity.name} from the plan?" } } %>
              </div>
            </li>
          <% end %>
        </ol>
      <% end %>

      <%= form_with url: scoped_path(:activities), method: :post, scope: :activity, id: "plan-add-form", class: "plan-add-form" do |form| %>
        <div>
          <%= form.label :name, "Add to the plan", class: "form-label" %>
          <%= form.text_field :name, class: "form-control", maxlength: 80, required: true, placeholder: "Pizza first" %>
        </div>
        <div class="plan-add-row">
          <div>
            <%= form.label :duration, "Length", class: "form-label" %>
            <%= form.select :duration, plan_duration_options(nil), { include_blank: "No length" }, class: "form-select" %>
          </div>
          <div>
            <%= form.label :description, "Description", class: "form-label" %>
            <%= form.text_field :description, class: "form-control", maxlength: 500, placeholder: "One line, optional" %>
          </div>
        </div>
        <%= form.submit "Add to the plan", class: "btn btn-primary" %>
      <% end %>
    </section>
  </div>
  <p><%= link_to "Back to the event", scoped_path, class: "quiet-link" %></p>
</div>
