<% content_for :head do %>
  <meta name="robots" content="noindex">
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="container py-5" id="claim">
  <h1>Keep <%= @event.name %> in your account</h1>
  <p>This links your invitation as <strong><%= @participant.email %></strong> to <strong><%= current_user.email %></strong>. The emailed link keeps working.</p>
  <%= button_to "Keep this event in my account", scoped_path(:claim), method: :post, class: "btn btn-primary" %>
  <p class="mt-3"><%= link_to "Back to the event", scoped_path %></p>
</div>
