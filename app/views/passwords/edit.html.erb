<h2>Choose a new password</h2>

<%= form_with model: @user, url: password_path(params[:token]), method: :patch do |form| %>
  <div class="form-inputs">
    <%= form.error_summary %>
    <%= form.field :password, as: :password_field, required: true, autofocus: true, autocomplete: "new-password",
          hint: "#{User::PASSWORD_MINIMUM} characters minimum" %>
    <%= form.field :password_confirmation, as: :password_field, required: true, autocomplete: "new-password" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Change my password", class: "btn btn-primary" %>
  </div>
<% end %>
