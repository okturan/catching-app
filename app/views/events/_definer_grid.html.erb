<%# The grid and the settings that redraw it, together, before the submit at
    every width. hint: :paint draws the painting instruction. %>
<div class="time-grid-panel time-grid-define-wrapper" data-controller="paint-mode">
  <h2><%= heading %></h2>
  <% if hint == :paint %>
    <p class="form-text" id="grid-paint-hint">Drag across the grid to paint the hours you could do. Drag again to clear. You need at least one.<span class="touch-only"> On a phone, switch to Paint to draw on the grid. Scroll moves the page.</span></p>
  <% end %>
  <div class="grid-controls">
    <%= render "events/grid_controls", event: event, frozen: frozen, begin_min: begin_min %>
  </div>
  <div class="time-grid-scroll">
    <table id="time-grid-define" class="time-grid" role="grid" aria-label="Offered times"
      tabindex="-1" aria-describedby="grid-paint-hint" data-definer-target="grid" data-paint-mode-target="grid"
      data-slot-minutes="<%= event.slot_minutes %>"
      data-time-zone="<%= event.time_zone.presence || params.dig(:event, :time_zone) %>"
      data-not-before="<%= TimeSlot::PAST_GRACE.ago.utc.iso8601 %>"></table>
  </div>
  <div class="grid-action-bar">
    <span id="selection-summary" aria-live="polite" data-definer-target="summary">No times selected</span>
    <fieldset id="paint-mode" class="paint-mode" role="radiogroup" aria-label="Touch mode" data-paint-mode-target="switch">
      <label><input type="radio" name="paint-mode" value="scroll" checked data-action="paint-mode#choose"><span>Scroll</span></label>
      <label><input type="radio" name="paint-mode" value="paint" data-action="paint-mode#choose"><span>Paint</span></label>
    </fieldset>
  </div>
</div>
