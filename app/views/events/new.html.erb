<div class="banner-events mb-1" style="height: 285px; background-image:url(https://res.cloudinary.com/dvpavvw1u/image/upload/v1633029501/blob-scene-haikei_2_fkcf9o.png);">
  <h1>WE HAVE SO MUCH CATCHING.APP TO DO!</h1>
</div>

<div class="event-new-grid">
  <div>
    <%= simple_form_for(@event) do |f| %>
      <%= f.error_notification %>
      <% if @event.errors[:base].any? %>
        <div class="alert alert-danger position-static" role="alert"><%= @event.errors[:base].to_sentence %></div>
      <% end %>
      <input name="time_slots[time_slot_array]" id="time_slot_array" type="hidden" value="<%= params.dig(:time_slots, :time_slot_array) %>">
      <div class="form-events" style="background-image:url(https://res.cloudinary.com/dvpavvw1u/image/upload/v1633004095/meetingform2_puuthd.png);">
        <%= f.input :name, placeholder: "A Fabulous Meeting!" %>
        <%= f.input :description, as: :text, placeholder: "Do whatever!" %>

        <% unless user_signed_in? %>
          <div class="mb-3">
            <label class="form-label" for="organizer_name">Your name</label>
            <input class="form-control" type="text" id="organizer_name" name="organizer[name]" maxlength="100" required value="<%= @organizer[:name] %>">
          </div>
          <div class="mb-3">
            <label class="form-label" for="organizer_email">Your email (we send your organizer link there)</label>
            <input class="form-control" type="email" id="organizer_email" name="organizer[email]" autocomplete="email" required value="<%= @organizer[:email] %>">
          </div>
        <% end %>

        <div class="mb-3">
          <label class="form-label" for="invitations_emails">Invite people (one address per line or comma-separated)</label>
          <textarea class="form-control" id="invitations_emails" name="invitations[emails]" rows="3"><%= params.dig(:invitations, :emails) %></textarea>
        </div>

        <%= f.input :slot_minutes, label: "Slot length", collection: [ [ "15 minutes", 15 ], [ "30 minutes", 30 ], [ "60 minutes", 60 ] ],
          include_blank: false, selected: @event.slot_minutes, input_html: { class: "form-select" } %>

        <div class="mb-3">
          <label class="form-label" for="timezone-picker-new">I am in:</label>
          <select class="form-select" id="timezone-picker-new" name="event[time_zone]" data-selected="<%= @event.time_zone.presence || params.dig(:event, :time_zone) %>"></select>
        </div>

        <div class="mb-3">
          <label class="form-label" for="event-begin">Start date:</label>
          <input class="form-control" type="date" id="event-begin" value="" />
        </div>
        <div class="mb-4">
          <label class="form-label" for="event-end">End date:</label>
          <input class="form-control" type="date" id="event-end" value="" />
        </div>
        <div class="text-danger" id="range-tooltip" role="status">
        </div>

        <%= f.submit "Catch.App with your Friends!", class: "btn-meeting mb-0" %>
      </div>
    <% end %>
  </div>

  <div class="time-grid-panel time-grid-define-wrapper">
    <div class="time-grid-scroll">
      <table id="time-grid-define" class="time-grid" role="grid" aria-label="Offered times" data-slot-minutes="<%= @event.slot_minutes %>" data-time-zone="<%= @event.time_zone.presence || params.dig(:event, :time_zone) %>"></table>
    </div>
    <div class="grid-action-bar">
      <span id="selection-summary" aria-live="polite">No times selected</span>
      <fieldset id="paint-mode" class="paint-mode" role="radiogroup" aria-label="Touch mode">
        <label><input type="radio" name="paint-mode" value="scroll" checked><span>Scroll</span></label>
        <label><input type="radio" name="paint-mode" value="paint"><span>Paint</span></label>
      </fieldset>
    </div>
  </div>
</div>
