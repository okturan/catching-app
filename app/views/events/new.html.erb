<div class="page-head">
  <h1>Offer the times you can do.</h1>
  <p class="lede mb-0">Paint your free hours on the grid, in your own zone. Your friends see them in theirs.</p>
</div>

<%# The form element is the two-column grid, so the grid panel and its controls
    sit inside the form and can be ordered against the submit. Exactly three
    children, in document order: the meeting, the grid, who you are. The submit
    is the last thing in the last child, so on a phone the visitor meets the
    grid — the only genuinely required input — before the button. %>
<%= form_with model: @event, class: "event-new-grid", data: { controller: "definer", action: "definer#submit" } do |form| %>
  <input name="time_slots[time_slot_array]" id="time_slot_array" type="hidden" value="<%= params.dig(:time_slots, :time_slot_array) %>"
    data-definer-target="slots">

  <%# One summary for the whole form, first child, full width: the grid's
      refusals, then the fields, then the organizer's two. %>
  <%= form.error_summary(planning_error_links(@event, @organizer)) %>

  <section class="form-events" aria-labelledby="meeting-heading">
    <h2 id="meeting-heading">The meeting</h2>

    <%# Required is the rule and carries no mark; the rest say "(optional)". %>
    <%= form.field :name, required: true, maxlength: 120, hint: "Your friends see this in the invitation." %>
    <%= form.field :description, as: :text_area, optional: true, rows: 3, maxlength: 2000, placeholder: "Do whatever!",
          hint: "Anything your friends should know. You can add this later." %>
    <%= form.field :place, optional: true, maxlength: 200, placeholder: "Ege's place, Kadıköy — or 'Zoom'",
          hint: "Where you'll meet, or the app you'll use." %>
    <%= form.field :place_url, as: :url_field, optional: true, maxlength: 2000, placeholder: "Link to join or a map link",
          hint: "A joining link or a map link. It must start with http:// or https://." %>
    <%= form.field :duration_minutes, as: :select, optional: true, include_blank: "Not set",
          choices: duration_select_options(@event.slot_minutes, @event.duration_minutes), describedby: "duration-note",
          data: { definer_target: "duration" },
          hint: "How long the meeting itself runs. Lengths that are not a whole number of your slot length are greyed out." do %>
      <%# Written by the definer when a step change drops the chosen length. %>
      <p class="form-text" id="duration-note" role="status" data-definer-target="durationNote"></p>
    <% end %>
  </section>

  <%= render "events/definer_grid", event: @event, frozen: false, begin_min: nil,
        heading: "When could you do it?", hint: :paint %>

  <section class="form-events" aria-labelledby="organizer-heading">
    <h2 id="organizer-heading">Where do we send your link?</h2>
    <% if authenticated? %>
      <p class="form-note">Planning as <%= @organizer.name %> (<%= @organizer.email %>).</p>
    <% else %>
      <%= fields_for :organizer, @organizer do |organizer| %>
        <%= organizer.field :name, label: "Your name", required: true, maxlength: 100, autocomplete: "name",
              hint: "Your friends see this as the organizer." %>
        <%= organizer.field :email, as: :email_field, label: "Your email", required: true, autocomplete: "email",
              hint: "We send your organizer link here — it is the only way back into this event." %>
      <% end %>
    <% end %>

    <p class="form-note">We email your organizer link to that address. Nothing reaches your friends until you open that link and press Send. Keep the email — that link is how you get back to this event.</p>
    <%= form.submit "Send me my organizer link", class: "btn-meeting mb-0" %>
  </section>
<% end %>
