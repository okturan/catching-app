<%= form_with model: @user, url: account_path, method: :patch do |form| %>
  <div class="form-inputs">
    <h2>Your account</h2>
    <%= form.error_summary %>
    <%= form.field :first_name, required: true, autocomplete: "given-name" %>
    <%= form.field :last_name, required: true, autocomplete: "family-name" %>
    <%= form.field :email, as: :email_field, required: true, autocomplete: "email" %>
    <% unless @user.email_confirmed? %>
      <p class="form-text account-unconfirmed">Not confirmed yet. Use the link we emailed, or ask for a new one below.</p>
    <% end %>
    <%= form.field :password, as: :password_field, optional: true, autocomplete: "new-password",
          hint: "Leave it blank to keep the one you have." %>
    <%= form.field :password_confirmation, as: :password_field, optional: true, autocomplete: "new-password" %>
    <%= form.field :password_challenge, as: :password_field, required: true, autocomplete: "current-password",
          hint: "We need it to confirm any change." %>
  </div>

  <div class="form-actions">
    <%= form.submit "Update", class: "btn btn-primary" %>
  </div>
<% end %>

<% unless @user.email_confirmed? %>
  <%= button_to "Send the confirmation link again", resend_email_confirmation_path, method: :post, class: "btn btn-link", form: { class: "account-resend" } %>
<% end %>

<p>Unhappy? <%= link_to "Delete my account", account_path,
  data: { turbo_method: :delete, turbo_confirm: "Delete your account? Your events stay; they stop showing up here." } %></p>

<p><%= link_to "Back", dashboard_path, class: "back-link" %></p>
