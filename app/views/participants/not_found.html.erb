<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>
<div class="container py-5" id="link-not-found">
  <h1>This link is not valid.</h1>
  <p>Open the newest email about this event: a newer link replaces older ones, or ask the organizer to resend your invitation.</p>
  <p>If you organized this event, <%= link_to "request a new organizer link", new_organizer_link_path %>.</p>
</div>
