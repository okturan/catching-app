<section class="organizer-panel guests-panel" aria-labelledby="participants-heading">
  <h2 id="participants-heading">Guests<% if guests.any? %> <span class="plate"><%= guests.size %></span><% end %></h2>
  <% if event.cancelled? %>
  <% elsif !organizer.link_opened_at? %>
    <p class="guests-blocked">
      Open the organizer link we emailed to <%= organizer.email %> to send invitations.
    </p>
    <%= button_to "Send the link again", organizer_links_path, method: :post, class: "btn btn-outline-secondary btn-sm",
      params: { "organizer_link[email]" => organizer.email } %>
  <% elsif !event.finalized? %>
    <%= form_with url: participant_invitations_path(organizer), method: :post, class: "guests-invite" do |form| %>
      <%= form.label :emails, "Invite more people", for: "invitations_emails", class: "form-label" %>
      <%= form.text_area :emails, id: "invitations_emails", name: "invitations[emails]", class: "form-control", rows: 3,
            aria: { describedby: "invitations-hint" } %>
      <p class="form-text" id="invitations-hint">One address per line, or separated by commas. Each friend gets their own link.</p>
      <%= form.submit(counts[:unsent].positive? ? "Send #{pluralize(counts[:unsent], 'invitation')}" : "Send invitations", class: "btn-meeting") %>
    <% end %>
  <% end %>

  <% if guests.any? %>
    <table class="guest-table" id="participant-table">
      <thead>
        <tr><th scope="col">Guest</th><th scope="col">State</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
      </thead>
      <tbody>
        <% guests.each do |guest| %>
          <tr class="<%= "is-left" if guest.left? %>">
            <td class="guest-who">
              <% if guest.name.present? %>
                <strong><%= guest.name %></strong>
                <span><%= guest.email %></span>
              <% else %>
                <strong><%= guest.email %></strong>
              <% end %>
            </td>
            <td class="guest-state"><%= guest_state_label(guest, invitations, slot_count: slot_counts[guest.id].to_i) %></td>
            <td class="guest-actions">
              <% if !guest.left? && event.open? && organizer.link_opened_at? %>
                <%= button_to "Resend", participant_guest_resend_path(organizer, guest), method: :post, class: "btn btn-link btn-sm" %>
                <%= button_to "Show link to copy", participant_guest_link_reveal_path(organizer, guest), method: :post, class: "btn btn-link btn-sm",
                  form: { data: { turbo_confirm: "Anyone with this link can answer as this guest. Show it?" } } %>
              <% end %>
              <% if !guest.left? && event.open? %>
                <%= button_to "Remove", participant_guest_path(organizer, guest), method: :delete, class: "btn btn-link btn-sm text-danger",
                  form: { data: { turbo_confirm: "Remove #{guest.email} from this event?" } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
