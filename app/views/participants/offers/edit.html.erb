<% content_for :head do %>
  <meta name="robots" content="noindex">
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<% content_for :canonical_url, root_url %>
<% content_for :meta_title, "Change the times · #{@event.name} · Catching App" %>

<div class="page-head">
  <h1>Change the times</h1>
  <p class="lede mb-0">Paint the times you can offer now. Guests keep every pick that stays; picks at removed times are dropped.</p>
</div>

<%# The same layout as events/new: the grid comes before the button on a phone. %>
<%= form_with model: @event, url: participant_offer_path(@participant), method: :patch, id: "offer-form", class: "event-new-grid",
      data: { controller: "definer", action: "definer#submit", definer_offer_value: @current_offer, definer_picked_counts_value: @guest_picked_counts } do |form| %>
  <input name="time_slots[time_slot_array]" id="time_slot_array" type="hidden" value="<%= @hydrated %>" data-definer-target="slots">
  <%= form.error_summary(definer_error_links(@event)) %>

  <div class="form-events">
    <p class="offer-event-name"><%= @event.name %></p>
    <% if @past_count.positive? %>
      <p class="offer-note mb-0"><%= @past_count == 1 ? "1 past time stays as it is" : "#{@past_count} past times stay as they are" %></p>
    <% end %>
  </div>

  <%= render "events/definer_grid", event: @event, frozen: @event.grid_frozen?, begin_min: @begin_min,
        heading: "The times you offer", hint: :paint %>

  <div class="form-events">
    <% if notice_offered? %>
      <div class="form-check mb-4">
        <%= hidden_field_tag "notice[send]", "0", id: nil %>
        <%= check_box_tag "notice[send]", "1", params.dig(:notice, :send) != "0", id: "notice_send", class: "form-check-input" %>
        <%= label_tag "notice_send", "Email the guests who already replied", class: "form-check-label" %>
      </div>
    <% end %>
    <%= form.submit "Save the new times", class: "btn-meeting mb-0" %>
    <p class="mt-3 mb-0"><%= link_to "Back to the event", participant_path(@participant), class: "quiet-link" %></p>
  </div>
<% end %>
