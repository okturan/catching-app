<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <p class="text-uppercase text-muted mb-1"><%= @event.name %></p>
      <h1>Activities</h1>
    </div>
    <% if @participation.organizer? %>
      <%= link_to "Add activity", new_event_activity_path(@event), class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="container-cards">
    <% @activities.each do |activity| %>
      <div class="card__container">
        <%= link_to event_activity_path(@event, activity), class: "card text-decoration-none" do %>
          <div class="card__content">
            <h2><%= activity.name %></h2>
            <p><%= activity.description %></p>
            <p class="mb-0"><%= pluralize(activity.duration, "minute") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to event", my_participation_path(@participation), class: "btn btn-link mt-4" %>
</div>
