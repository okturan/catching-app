# Copy to .env for local development. APP_HOST is a hostname without a scheme.
APP_HOST=localhost
MAILER_FROM=no-reply@localhost
# SEED_PASSWORD=development-password

# Required in production:
# DATABASE_URL=postgresql://user:password@database.example.com/catching_app_production
# SECRET_KEY_BASE=generate-with-bin-rails-secret
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Optional: daily ceiling on invitation mails across the whole app (default 500).
# INVITATION_DAILY_BUDGET=500
# Thruster logs every request path, including capability links; the Dockerfile sets
# LOG_REQUESTS=false. Keep it off wherever the image runs.
