{
  "name": "catching-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "test": "node --test test/javascript/time_grid.test.js",
    "build": "esbuild app/javascript/application.js --bundle --minify --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass app/assets/stylesheets/application.scss:app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import",
    "check": "npm test && npm run build && npm run build:css"
  },
  "dependencies": {
    "@hotwired/turbo-rails": "^8.0.23",
    "bootstrap": "^5.3.8",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.102.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true
  }
}
